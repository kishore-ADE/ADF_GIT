{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-kishore-qa-json"
		},
		"LS_Sink_ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_Sink_ADLS'"
		},
		"LS_Sink_ADLS_P_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_Sink_ADLS_P'"
		},
		"LS_Source_SQl_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_Source_SQl'"
		},
		"Onprem_Source_Sql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Onprem_Source_Sql'"
		},
		"LS_Sink_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stadlsqa.dfs.core.windows.net/"
		},
		"LS_Sink_ADLS_P_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stadlsqa.dfs.core.windows.net/"
		},
		"LS_Source_Json_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://jsonplaceholder.typicode.com/"
		},
		"LS_Source_SQl_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "kingfisher18.database.windows.net"
		},
		"LS_Source_SQl_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "KishoreAdventure"
		},
		"LS_Source_SQl_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Virat"
		},
		"Onprem_Source_Sql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "LP-PG05FBSD"
		},
		"Onprem_Source_Sql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "adventure"
		},
		"Onprem_Source_Sql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Virat"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-kishore-qa-json_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_Sink_ADLS_accountKey": {
						"value": "[parameters('LS_Sink_ADLS_accountKey')]"
					},
					"LS_Sink_ADLS_P_accountKey": {
						"value": "[parameters('LS_Sink_ADLS_P_accountKey')]"
					},
					"LS_Source_SQl_password": {
						"value": "[parameters('LS_Source_SQl_password')]"
					},
					"Onprem_Source_Sql_password": {
						"value": "[parameters('Onprem_Source_Sql_password')]"
					},
					"LS_Sink_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_Sink_ADLS_properties_typeProperties_url')]"
					},
					"LS_Sink_ADLS_P_properties_typeProperties_url": {
						"value": "[parameters('LS_Sink_ADLS_P_properties_typeProperties_url')]"
					},
					"LS_Source_Json_properties_typeProperties_url": {
						"value": "[parameters('LS_Source_Json_properties_typeProperties_url')]"
					},
					"LS_Source_SQl_properties_typeProperties_server": {
						"value": "[parameters('LS_Source_SQl_properties_typeProperties_server')]"
					},
					"LS_Source_SQl_properties_typeProperties_database": {
						"value": "[parameters('LS_Source_SQl_properties_typeProperties_database')]"
					},
					"LS_Source_SQl_properties_typeProperties_userName": {
						"value": "[parameters('LS_Source_SQl_properties_typeProperties_userName')]"
					},
					"Onprem_Source_Sql_properties_typeProperties_server": {
						"value": "[parameters('Onprem_Source_Sql_properties_typeProperties_server')]"
					},
					"Onprem_Source_Sql_properties_typeProperties_database": {
						"value": "[parameters('Onprem_Source_Sql_properties_typeProperties_database')]"
					},
					"Onprem_Source_Sql_properties_typeProperties_userName": {
						"value": "[parameters('Onprem_Source_Sql_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}